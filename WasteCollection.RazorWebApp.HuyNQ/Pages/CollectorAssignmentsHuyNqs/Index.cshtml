@page
@model WasteCollection.RazorWebApp.HuyNQ.Pages.CollectorAssignmentsHuyNqs.IndexModel

@{
    ViewData["Title"] = "Collector Assignments";
}

<!-- Tailwind is now in _Layout, but keeping it here just in case specific overrides needed, though redundant if layout has it.
     We can remove the script tag if we are sure _Layout loads it. Leaving it out for cleaner code as _Layout handles it. -->

<div class="p-6 bg-gray-50 min-h-screen">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="flex flex-col md:flex-row justify-between items-center mb-6">
            <div>
                <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Collector Assignments</h1>
                <p class="mt-1 text-sm text-gray-500">Manage and track your waste collection tasks efficiently.</p>
            </div>
            <a asp-page="Create" class="mt-4 md:mt-0 inline-flex items-center justify-center px-5 py-2 border border-transparent text-sm font-medium rounded-full text-white bg-green-600 hover:bg-green-700 shadow-sm transition-all duration-200">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Create New
            </a>
        </div>

        <!-- Search Form -->
        <form method="get" class="mb-6 bg-white rounded-2xl shadow-md border border-gray-100 p-5">
            <div class="flex flex-col md:flex-row gap-4 items-end">
                <!-- Status -->
                <div class="flex-1">
                    <label for="SearchStatus" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Status</label>
                    <select id="SearchStatus" name="SearchOptions.Status"
                            class="w-full px-4 py-2 border border-gray-200 rounded-lg text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-green-400 transition bg-white">
                        <option value="">— All —</option>
                        <option value="Assigned"   selected="@(Model.SearchOptions.Status == "Assigned"   ? "selected" : null)">Assigned</option>
                        <option value="OnTheWay"   selected="@(Model.SearchOptions.Status == "OnTheWay"   ? "selected" : null)">On The Way</option>
                        <option value="Collected"  selected="@(Model.SearchOptions.Status == "Collected"  ? "selected" : null)">Collected</option>
                        <option value="Cancelled"  selected="@(Model.SearchOptions.Status == "Cancelled"  ? "selected" : null)">Cancelled</option>
                    </select>
                </div>

                <!-- Collected Weight -->
                <div class="flex-1">
                    <label for="SearchCollectedWeight" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Collected Weight (kg)</label>
                    <input id="SearchCollectedWeight" name="SearchOptions.CollectedWeight" type="number" step="0.01" min="0"
                           value="@Model.SearchOptions.CollectedWeight"
                           placeholder="e.g. 12.5"
                           class="w-full px-4 py-2 border border-gray-200 rounded-lg text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-green-400 transition" />
                </div>

                <!-- Assigned Date -->
                <div class="flex-1">
                    <label for="SearchAssignedDate" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Assigned Date</label>
                    <input id="SearchAssignedDate" name="SearchOptions.AssignedDate" type="date"
                           value="@(Model.SearchOptions.AssignedDate.HasValue ? Model.SearchOptions.AssignedDate.Value.ToString("yyyy-MM-dd") : "")"
                           class="w-full px-4 py-2 border border-gray-200 rounded-lg text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-green-400 transition" />
                </div>

                <!-- Buttons -->
                <div class="flex gap-2 shrink-0">
                    <button type="submit"
                            class="inline-flex items-center px-5 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium rounded-lg shadow-sm transition-all duration-200">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z" />
                        </svg>
                        Search
                    </button>
                    @if (Model.IsSearching)
                    {
                        <a asp-page="./Index" class="inline-flex items-center px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-600 text-sm font-medium rounded-lg transition-all duration-200">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                            Clear
                        </a>
                    }
                </div>
            </div>

            @if (Model.IsSearching)
            {
                <div class="mt-3 flex items-center gap-2 text-xs text-green-700 font-medium">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z" />
                    </svg>
                    Showing filtered results &mdash; @Model.PagedResult.TotalCount record(s) found
                </div>
            }
        </form>

        <!-- Content Card -->
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                Assignment Info
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                Status
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                Timings
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                Outcome
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                Location & Notes
                            </th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">
                                Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody id="collectorAssignmentTBodyId" class="bg-white divide-y divide-gray-200">
                        @foreach (var item in Model.PagedResult.Items)
                        {
                            <tr id="@item.AssignmentId" class="hover:bg-gray-50 transition-colors duration-150 relative">
                                <td class="px-6 py-4">
                                    <div class="text-sm font-medium text-gray-900">
                                        @Html.DisplayFor(modelItem => item.AssignedDate)
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @{
                                        var statusStr = item.Status?.ToString() ?? "";
                                        var badgeColor = "bg-gray-100 text-gray-800";
                                        if (statusStr.Contains("Completed") || statusStr.Contains("Collected"))
                                            badgeColor = "bg-green-100 text-green-800";
                                        else if (statusStr.Contains("Pending") || statusStr.Contains("Assigned"))
                                            badgeColor = "bg-blue-100 text-blue-800";
                                        else if (statusStr.Contains("Way") || statusStr.Contains("InProgress"))
                                            badgeColor = "bg-indigo-100 text-indigo-800";
                                        else if (statusStr.Contains("Cancel"))
                                            badgeColor = "bg-red-100 text-red-800";
                                    }
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full @badgeColor">
                                        @Html.DisplayFor(modelItem => item.Status)
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-xs text-gray-500">
                                        <span class="font-semibold text-gray-700">ETA:</span> @Html.DisplayFor(modelItem => item.EstimatedArrivalTime)
                                    </div>
                                    <div class="text-xs text-gray-500 mt-1">
                                        <span class="font-semibold text-gray-700">Arr:</span> @Html.DisplayFor(modelItem => item.ArrivalTime)
                                    </div>
                                    <div class="text-xs text-gray-500 mt-1">
                                        <span class="font-semibold text-gray-700">Done:</span> @Html.DisplayFor(modelItem => item.CompletionTime)
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-900 font-medium">
                                        @Html.DisplayFor(modelItem => item.CollectedWeight) kg
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.ProofImageUrl))
                                    {
                                        <a href="@item.ProofImageUrl" target="_blank" class="flex items-center text-xs text-indigo-600 hover:text-indigo-900 underline mt-1">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                            </svg>
                                            View Proof
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-gray-400 italic">No Image</span>
                                    }
                                </td>
                                <td class="px-6 py-4">
                                    <div class="text-sm text-gray-900 truncate max-w-[150px]" title="@item.Address">
                                        @Html.DisplayFor(modelItem => item.Address)
                                    </div>
                                    <div class="text-xs text-gray-500 mt-1 truncate max-w-[150px]" title="@item.Notes">
                                        @Html.DisplayFor(modelItem => item.Notes)
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <div class="relative inline-block text-left">
                                        <!-- Three dots button -->
                                        <button type="button" onclick="toggleDropdown('@item.AssignmentId')" class="text-gray-400 hover:text-gray-600 p-2 rounded-full hover:bg-gray-100 transition-colors focus:outline-none">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                                <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z" />
                                            </svg>
                                        </button>

                                        <!-- Dropdown menu -->
                                        <div id="dropdown-@item.AssignmentId" class="hidden absolute right-0 mt-2 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 z-20 origin-top-right">
                                            <div class="py-1" role="menu" aria-orientation="vertical" aria-labelledby="options-menu">
                                                <a asp-page="./Edit" asp-route-id="@item.AssignmentId" class="group flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-green-700" role="menuitem">
                                                    <svg class="mr-3 h-5 w-5 text-gray-400 group-hover:text-green-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                    </svg>
                                                    Edit
                                                </a>
                                                <a asp-page="./Details" asp-route-id="@item.AssignmentId" class="group flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-blue-700" role="menuitem">
                                                    <svg class="mr-3 h-5 w-5 text-gray-400 group-hover:text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                    </svg>
                                                    Details
                                                </a>
                                                <a asp-page="./Delete" asp-route-id="@item.AssignmentId" class="group flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-red-700" role="menuitem">
                                                    <svg class="mr-3 h-5 w-5 text-gray-400 group-hover:text-red-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                    </svg>
                                                    Delete
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!Model.PagedResult.Items.Any())
                {
                    <div class="text-center py-12">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                        </svg>
                        <p class="mt-2 text-gray-500">No assignments found.</p>
                        <a asp-page="Create" class="mt-4 inline-block text-indigo-600 hover:text-indigo-800 font-medium">Create your first assignment &rarr;</a>
                    </div>
                }
            </div>

            @{
                var pr = Model.PagedResult;
                // Build a helper to generate page links preserving all current query params
                string PageUrl(int page)
                {
                    var qs = new System.Text.StringBuilder("?");
                    if (!string.IsNullOrEmpty(Model.SearchOptions.Status))
                        qs.Append($"SearchOptions.Status={Uri.EscapeDataString(Model.SearchOptions.Status)}&");
                    if (Model.SearchOptions.CollectedWeight.HasValue)
                        qs.Append($"SearchOptions.CollectedWeight={Model.SearchOptions.CollectedWeight}&");
                    if (Model.SearchOptions.AssignedDate.HasValue)
                        qs.Append($"SearchOptions.AssignedDate={Model.SearchOptions.AssignedDate.Value:yyyy-MM-dd}&");
                    qs.Append($"SearchOptions.PageNumber={page}&SearchOptions.PageSize={pr.PageSize}");
                    return Url.Page("./Index") + qs.ToString();
                }
            }

            @if (pr.TotalPages > 1)
            {
                <div class="px-6 py-4 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4">
                    <p class="text-sm text-gray-500" id="pagination-info-text">
                        Showing
                        <span class="font-semibold text-gray-700">@((pr.PageNumber - 1) * pr.PageSize + 1)</span>
                        –
                        <span class="font-semibold text-gray-700">@Math.Min(pr.PageNumber * pr.PageSize, pr.TotalCount)</span>
                        of
                        <span class="font-semibold text-gray-700" id="pagination-total-count">@pr.TotalCount</span>
                        results
                    </p>

                    <!-- Page buttons -->
                    <nav class="flex items-center gap-1">
                        @* Previous *@
                        @if (pr.HasPrev)
                        {
                            <a href="@PageUrl(pr.PageNumber - 1)"
                               class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-gray-600 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                                </svg>
                                Prev
                            </a>
                        }
                        else
                        {
                            <span class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-gray-300 bg-gray-50 border border-gray-100 rounded-lg cursor-not-allowed">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                                </svg>
                                Prev
                            </span>
                        }

                        @* Page numbers (show at most 5 around current page) *@
                        @{
                            int startPage = Math.Max(1, pr.PageNumber - 2);
                            int endPage   = Math.Min(pr.TotalPages, startPage + 4);
                            startPage     = Math.Max(1, endPage - 4);
                        }
                        @for (int p = startPage; p <= endPage; p++)
                        {
                            if (p == pr.PageNumber)
                            {
                                <span class="inline-flex items-center justify-center w-9 h-9 text-sm font-semibold text-white bg-green-600 border border-green-600 rounded-lg">
                                    @p
                                </span>
                            }
                            else
                            {
                                <a href="@PageUrl(p)"
                                   class="inline-flex items-center justify-center w-9 h-9 text-sm font-medium text-gray-600 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                                    @p
                                </a>
                            }
                        }

                        @* Next *@
                        @if (pr.HasNext)
                        {
                            <a href="@PageUrl(pr.PageNumber + 1)"
                               class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-gray-600 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                                Next
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </a>
                        }
                        else
                        {
                            <span class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-gray-300 bg-gray-50 border border-gray-100 rounded-lg cursor-not-allowed">
                                Next
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </span>
                        }
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

<script>
    function toggleDropdown(id) {
        // Close all other dropdowns
        document.querySelectorAll('[id^="dropdown-"]').forEach(el => {
            if (el.id !== 'dropdown-' + id) {
                el.classList.add('hidden');
            }
        });

        // Toggle current
        const dropdown = document.getElementById('dropdown-' + id);
        dropdown.classList.toggle('hidden');
    }

    // Close when clicking outside
    window.addEventListener('click', function(e) {
        if (!e.target.closest('.relative')) {
            document.querySelectorAll('[id^="dropdown-"]').forEach(el => {
                el.classList.add('hidden');
            });
        }
    });
</script>

<script src="~/js/signalr/dist/browser/signalr.js"></script>
<script>
    "use strict";

    var connection = new signalR.HubConnectionBuilder().withUrl("/wasteCollectionHub").build();

    connection.start().then(function () {
        console.log("Client: Connected to the SignalR Hub");
    }).catch(function (err) {
        return console.error(err.toString());
    });

    // Handle assignment deletion
    connection.on("ReceiveDelete_CollectorAssignments", function (assignmentId) {
        const row = document.getElementById(assignmentId);
        if (row) {
            row.remove();
            
            // Update total count if element exists
            const totalCountEl = document.getElementById('pagination-total-count');
            if (totalCountEl) {
                let currentTotal = parseInt(totalCountEl.innerText) || 0;
                if (currentTotal > 0) {
                    totalCountEl.innerText = (currentTotal - 1).toString();
                }
            }

            if(typeof showToast === "function") {
                showToast("Assignment deleted successfully.", "error");
            }
        } else {
             $('#collectorAssignmentTBodyId').find(`tr[id='${assignmentId}']`).remove();
        }
    });

    // Handle assignment creation
    connection.on("ReceiveCreate_CollectorAssignments", function (item) {
        console.log(item);

        const id = item.assignmentId ?? item.AssignmentId ?? '';

        // Add helpers near the top of the handler
        function parseServerDate(value) {
            if (!value) return null;

            // Handle .NET "/Date(1234567890)/" format
            var m = /\/Date\((\d+)(?:[-+]\d+)?\)\//.exec(value);
            if (m) return new Date(parseInt(m[1], 10));

            // If it's a numeric timestamp
            if (typeof value === 'number') return new Date(value);

            // Try ISO / other string formats
            var d = new Date(value);
            return isNaN(d.getTime()) ? null : d;
        }

        function formatDateTime(value) {
            var d = parseServerDate(value);
            if (!d) return '';

            var month = d.getMonth() + 1;
            var day = d.getDate();
            var year = d.getFullYear();

            var hours = d.getHours();
            var minutes = d.getMinutes().toString().padStart(2, '0');
            var seconds = d.getSeconds().toString().padStart(2, '0');

            var ampm = hours >= 12 ? 'PM' : 'AM';
            var hour12 = hours % 12;
            if (hour12 === 0) hour12 = 12;

            return month + '/' + day + '/' + year + ' ' + hour12 + ':' + minutes + ':' + seconds + ' ' + ampm;
        }

        // Then use the helpers before building the `tr`
        const assignedDateStr         = formatDateTime(item.assignedDate);
        const estimatedArrivalStr     = formatDateTime(item.estimatedArrivalTime);
        const arrivalTimeStr          = formatDateTime(item.arrivalTime);
        const completionTimeStr       = formatDateTime(item.completionTime);

        function badgeClass(status) {
            if (!status) return 'bg-gray-100 text-gray-800';
            status = status.toString();
            if (status.includes('Completed') || status.includes('Collected')) return 'bg-green-100 text-green-800';
            if (status.includes('Pending') || status.includes('Assigned')) return 'bg-blue-100 text-blue-800';
            if (status.includes('Way') || status.includes('InProgress')) return 'bg-indigo-100 text-indigo-800';
            if (status.includes('Cancel')) return 'bg-red-100 text-red-800';
            return 'bg-gray-100 text-gray-800';
        }

        const proofHtml = item.proofImageUrl
            ? `<a href="${item.proofImageUrl}" target="_blank" class="flex items-center text-xs text-indigo-600 hover:text-indigo-900 underline mt-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    View Proof
               </a>`
            : `<span class="text-xs text-gray-400 italic">No Image</span>`;

        const tr = `
            <tr id="${id}" class="hover:bg-gray-50 transition-colors duration-150 relative">
                <td class="px-6 py-4">
                    <div class="text-sm font-medium text-gray-900">${assignedDateStr ?? ''}</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
